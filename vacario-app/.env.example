# Database. SQLite by default; point at Postgres for production
# (then change `provider` in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:./dev.db"

# Signing secret for session cookies. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-in-production-please-use-a-long-random-string"

# Where uploaded media is written, relative to /public
UPLOAD_DIR="uploads"
